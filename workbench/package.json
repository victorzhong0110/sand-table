{
  "name": "@sand-table/workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node --experimental-strip-types scripts/build-host.ts",
    "start": "node --experimental-strip-types server/main.ts",
    "dev": "node --experimental-strip-types dev/host.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --experimental-strip-types tests/browser.ts",
    "launch": "node --experimental-strip-types local/main.ts",
    "test:local": "node --experimental-strip-types tests/local.ts",
    "test:full": "npm run package:mcpb && node --experimental-strip-types tests/full.ts",
    "acceptance": "node --experimental-strip-types acceptance/kit.ts",
    "package:mcpb": "node --experimental-strip-types scripts/package-mcpb.ts",
    "test:performance": "node --experimental-strip-types tests/performance.ts",
    "test:blank": "node --experimental-strip-types tests/blank.ts",
    "test:host": "node --experimental-strip-types tests/host-browser.ts",
    "format:check": "prettier --check \"{board,core,connectors,domains,server,local,dev,scripts,tests}/**/*.{ts,tsx}\"",
    "test:recovery": "node --experimental-strip-types tests/recovery-browser.ts",
    "test:reopen": "node --experimental-strip-types tests/reopen-browser.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
