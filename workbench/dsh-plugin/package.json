{
  "name": "@sand-table/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Sand Table \u7684 DSH \u63d2\u4ef6\u5305\uff1aAgent \u53ef\u8bfb\u7684\u767d\u677f\u5de5\u5177 + \u4fa7\u680f\u767d\u677f\u9762\u677f + \u767d\u677f\u5185\u300c\u95ee AI\u300d\u5165\u53e3\u3002",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tasks.js"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
